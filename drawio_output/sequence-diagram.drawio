        <mxCell id="m2-3at" value="SELECT * FROM carts WHERE user_id=? (or createNewCart)" style="text;html=1;fontSize=8;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="390" y="218" width="210" height="20" as="geometry"/></mxCell>

