        <mxCell id="ll4-rs" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="110" as="sourcePoint"/><mxPoint x="360" y="1050" as="targetPoint"/></mxGeometry></mxCell>
