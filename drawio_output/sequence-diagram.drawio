        <mxCell id="m4-12t" value="restoreStock(productId, quantity)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="365" y="688" width="140" height="20" as="geometry"/></mxCell>

        <mxCell id="m4-13" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="505" y="740" as="sourcePoint"/><mxPoint x="800" y="740" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4-13t" value="UPDATE inventories SET available_quantity = available_quantity + ?" style="text;html=1;fontSize=8;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="520" y="718" width="200" height="20" as="geometry"/></mxCell>

        <mxCell id="m4-14" value="" style="endArrow=open;html=1;dashed=1;endFill=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="222" y="785" as="sourcePoint"/><mxPoint x="80" y="785" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4-14t" value="ApiResponse (RefundRecord)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="85" y="763" width="135" height="20" as="geometry"/></mxCell>

        <mxCell id="note4" value="&lt;b&gt;退货状态机:&lt;/b&gt; REQUESTED → APPROVED/REJECTED → RECEIVED → REFUNDED&#10;&lt;b&gt;关键约束:&lt;/b&gt; 只有 REQUESTED 状态可 approve/reject;&#10;只有 APPROVED/RECEIVED 状态才能处理退款" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="850" width="460" height="55" as="geometry" />
        </mxCell>
