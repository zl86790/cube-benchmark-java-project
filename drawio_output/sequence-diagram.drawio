        <!-- === Step 1: Create Return Request === -->
        <mxCell id="f4a-label" value="&lt;b&gt;1. 用户发起退货申请&lt;/b&gt;" style="text;html=1;fontSize=11;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="160" height="25" as="geometry" />
