        <mxCell id="m5-b2t" value="addFlashSaleItem(promotionId,productId,salePrice,stockLimit)" style="text;html=1;fontSize=8;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="208" y="528" width="210" height="20" as="geometry"/></mxCell>

        <mxCell id="m5-b3" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="607" y="580" as="sourcePoint"/><mxPoint x="750" y="580" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5-b3t" value="INSERT INTO flash_sale_items..." style="text;html=1;fontSize=8;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="615" y="558" width="130" height="20" as="geometry"/></mxCell>

        <!-- User purchases flash sale -->
        <mxCell id="m5-b4" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#d6242d;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="630" as="sourcePoint"/><mxPoint x="472" y="630" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5-b4t" value="[用户] POST /api/promotions/{id}/purchase&#10;(flashSaleItemId, quantity)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="75" y="608" width="170" height="30" as="geometry"/></mxCell>

        <mxCell id="m5-b5" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="472" y="670" as="sourcePoint"/><mxPoint x="607" y="670" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5-b5t" value="purchaseFlashSaleItem(promotionId, itemId, qty)" style="text;html=1;fontSize=8;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="475" y="648" width="130" height="20" as="geometry"/></mxCell>

        <mxCell id="m5-b6" value="验证: ✓ 活动有效期内? ✓ 库存足够?" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="490" y="700" width="180" height="20" as="geometry"/></mxCell>

        <mxCell id="m5-b7" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="607" y="735" as="sourcePoint"/><mxPoint x="750" y="735" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5-b7t" value="UPDATE flash_sale_items SET sold_count=sold_count+qty" style="text;html=1;fontSize=8;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="615" y="713" width="130" height="20" as="geometry"/></mxCell>

        <mxCell id="m5-b8" value="" style="endArrow=open;html=1;dashed=1;endFill=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="472" y="770" as="sourcePoint"/><mxPoint x="70" y="770" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5-b8t" value="ApiResponse (FlashSaleItem)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="75" y="748" width="160" height="20" as="geometry"/></mxCell>

        <mxCell id="note5" value="&lt;b&gt;优惠券类型:&lt;/b&gt; PERCENTAGE (百分比折扣) / FIXED (固定金额)&#10;&lt;b&gt;校验链:&lt;/b&gt; 激活状态 → 有效期 → 使用次数上限 → 最低订单金额 → 计算折扣&#10;&lt;b&gt;秒杀关键:&lt;/b&gt; 活动时间段 + 库存限制双重校验" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="30" y="840" width="520" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ===== Diagram 6: 积分与忠诚度流程 ===== -->
  <diagram name="6-积分与忠诚度流程" id="seq-loyalty">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connectable="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title6" value="&lt;b&gt;积分与忠诚度流程 (Loyalty Points Flow)&lt;/b&gt;" style="text;html=1;fontSize=16;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- Participants -->
        <mxCell id="p6-user" value="用户&lt;br&gt;User" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6-lc" value="Loyalty&lt;br&gt;Controller" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="60" width="85" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6-ls" value="Loyalty&lt;br&gt;Service" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="325" y="60" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p6-db" value="数据库&lt;br&gt;DB" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;size=10;" vertex="1" parent="1">
          <mxGeometry x="470" y="55" width="80" height="60" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="ll6-u" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="110" as="sourcePoint"/><mxPoint x="80" y="950" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll6-lc" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="222" y="110" as="sourcePoint"/><mxPoint x="222" y="950" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll6-ls" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="110" as="sourcePoint"/><mxPoint x="365" y="950" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll6-db" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="115" as="sourcePoint"/><mxPoint x="510" y="950" as="targetPoint"/></mxGeometry></mxCell>

        <!-- === Flow A: Get Account === -->
        <mxCell id="f6a-label" value="&lt;b&gt;查询积分账户&lt;/b&gt;" style="text;html=1;fontSize=11;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="130" height="25" as="geometry" />
        </mxCell>

        <mxCell id="m6-1" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="180" as="sourcePoint"/><mxPoint x="222" y="180" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6-1t" value="GET /api/loyalty/account" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="85" y="158" width="135" height="20" as="geometry"/></mxCell>

        <mxCell id="m6-2" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="222" y="210" as="sourcePoint"/><mxPoint x="365" y="210" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6-2t" value="getAccount(userId)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="230" y="188" width="130" height="20" as="geometry"/></mxCell>

        <mxCell id="m6-3" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="240" as="sourcePoint"/><mxPoint x="510" y="240" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6-3t" value="SELECT FROM loyalty_accounts WHERE user_id=? (不存在则创建)" style="text;html=1;fontSize=8;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="370" y="218" width="140" height="20" as="geometry"/></mxCell>

        <mxCell id="m6-4" value="" style="endArrow=open;html=1;dashed=1;endFill=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="222" y="275" as="sourcePoint"/><mxPoint x="80" y="275" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6-4t" value="ApiResponse (LoyaltyAccount)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="85" y="253" width="135" height="20" as="geometry"/></mxCell>

        <!-- === Flow B: Earn Points === -->
        <mxCell id="f6b-label" value="&lt;b&gt;赚取积分 (下单后)&lt;/b&gt;" style="text;html=1;fontSize=11;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="150" height="25" as="geometry" />
        </mxCell>

        <mxCell id="m6-b1" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="222" y="370" as="sourcePoint"/><mxPoint x="365" y="370" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6-b1t" value="earnPoints(userId, points, description)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="230" y="348" width="130" height="20" as="geometry"/></mxCell>

        <mxCell id="m6-b2" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="400" as="sourcePoint"/><mxPoint x="510" y="400" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6-b2t" value="UPDATE loyalty_accounts SET&#10;points_balance+=?, lifetime_points+=?" style="text;html=1;fontSize=8;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="370" y="378" width="135" height="30" as="geometry"/></mxCell>

        <mxCell id="m6-b3" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="440" as="sourcePoint"/><mxPoint x="510" y="440" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6-b3t" value="recordTransaction → INSERT INTO points_transactions (type=EARNED)" style="text;html=1;fontSize=8;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="370" y="418" width="135" height="20" as="geometry"/></mxCell>

        <mxCell id="m6-b4" value="" style="endArrow=open;html=1;dashed=1;endFill=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="222" y="475" as="sourcePoint"/><mxPoint x="80" y="475" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6-b4t" value="ApiResponse (updated LoyaltyAccount)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="85" y="453" width="135" height="20" as="geometry"/></mxCell>

        <!-- === Flow C: Redeem Points === -->
        <mxCell id="f6c-label" value="&lt;b&gt;兑换积分&lt;/b&gt;" style="text;html=1;fontSize=11;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="100" height="25" as="geometry" />
        </mxCell>

        <mxCell id="m6-c1" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="570" as="sourcePoint"/><mxPoint x="222" y="570" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6-c1t" value="POST /api/loyalty/redeem&#10;(points, description)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="85" y="548" width="135" height="30" as="geometry"/></mxCell>

        <mxCell id="m6-c2" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="222" y="610" as="sourcePoint"/><mxPoint x="365" y="610" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6-c2t" value="redeemPoints(userId, points, description)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="230" y="588" width="130" height="20" as="geometry"/></mxCell>

        <mxCell id="m6-c3" value="检查 pointsBalance >= points?&#10;否 → throw BusinessException(&quot;积分不足&quot;)" style="text;html=1;fontSize=9;align=left;fillColor=none;strokeColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="640" width="180" height="32" as="geometry"/></mxCell>

        <mxCell id="m6-c4" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#d6242d;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="365" y="690" as="sourcePoint"/><mxPoint x="510" y="690" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6-c4t" value="UPDATE loyalty_accounts SET points_balance-=?;&#10;INSERT INTO points_transactions (type=REDEEMED)" style="text;html=1;fontSize=8;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="370" y="668" width="140" height="30" as="geometry"/></mxCell>

        <mxCell id="m6-c5" value="" style="endArrow=open;html=1;dashed=1;endFill=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="222" y="730" as="sourcePoint"/><mxPoint x="80" y="730" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6-c5t" value="ApiResponse (updated LoyaltyAccount)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="85" y="708" width="135" height="20" as="geometry"/></mxCell>

        <mxCell id="note6" value="&lt;b&gt;积分账户:&lt;/b&gt; 首次访问自动创建; pointsBalance (可用) + lifetimePoints (累计)&#10;&lt;b&gt;交易类型:&lt;/b&gt; EARNED (赚取) / REDEEMED (兑换)&#10;&lt;b&gt;约束:&lt;/b&gt; 兑换时 pointsBalance 必须 ≥ 请求的 points" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="470" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
