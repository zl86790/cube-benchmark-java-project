          <mxGeometry x="1000" y="60" width="90" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p1-db" value="数据库&lt;br&gt;DB" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;size=10;" vertex="1" parent="1">
          <mxGeometry x="1140" y="55" width="80" height="60" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="ll1-u" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="80" y="110" as="sourcePoint"/><mxPoint x="80" y="1350" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="ll1-oc" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1">
