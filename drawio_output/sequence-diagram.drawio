        <mxCell id="m2-4ct" value="save(cart) → DELETE FROM cart_items WHERE id=?" style="text;html=1;fontSize=8;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="400" y="783" width="200" height="20" as="geometry"/></mxCell>

