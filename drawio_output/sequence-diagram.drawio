        <mxCell id="m4-1" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="180" as="sourcePoint"/><mxPoint x="222" y="180" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4-1t" value="POST /api/returns&#10;(orderId, reason)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="85" y="158" width="135" height="30" as="geometry"/></mxCell>

        <mxCell id="m4-2" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="222" y="220" as="sourcePoint"/><mxPoint x="360" y="220" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4-2t" value="createReturnRequest(orderId,userId,reason)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="225" y="198" width="135" height="20" as="geometry"/></mxCell>

        <mxCell id="m4-3" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="250" as="sourcePoint"/><mxPoint x="800" y="250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4-3t" value="save(request) → INSERT INTO return_requests (status=REQUESTED)" style="text;html=1;fontSize=8;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="390" y="228" width="240" height="20" as="geometry"/></mxCell>

        <mxCell id="m4-4" value="" style="endArrow=open;html=1;dashed=1;endFill=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="222" y="285" as="sourcePoint"/><mxPoint x="80" y="285" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4-4t" value="ApiResponse (ReturnRequest, status=REQUESTED)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="85" y="263" width="135" height="20" as="geometry"/></mxCell>

        <!-- === Step 2: Admin Approve === -->
        <mxCell id="f4b-label" value="&lt;b&gt;2. 管理员审批&lt;/b&gt;" style="text;html=1;fontSize=11;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="140" height="25" as="geometry" />
