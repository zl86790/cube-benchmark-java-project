        <mxCell id="ll5-cpn" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="202" y="110" as="sourcePoint"/><mxPoint x="202" y="1150" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll5-cs" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="337" y="110" as="sourcePoint"/><mxPoint x="337" y="1150" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll5-promo" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="472" y="110" as="sourcePoint"/><mxPoint x="472" y="1150" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll5-prs" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="607" y="110" as="sourcePoint"/><mxPoint x="607" y="1150" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll5-db" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="115" as="sourcePoint"/><mxPoint x="750" y="1150" as="targetPoint"/></mxGeometry></mxCell>

        <!-- === Flow A: Coupon Redemption === -->
        <mxCell id="f5a-label" value="&lt;b&gt;优惠券核销流程&lt;/b&gt;" style="text;html=1;fontSize=11;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="140" width="140" height="25" as="geometry" />
        </mxCell>

        <mxCell id="m5-1" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="180" as="sourcePoint"/><mxPoint x="202" y="180" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5-1t" value="POST /api/coupons/redeem&#10;(code, orderId, orderAmount)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="75" y="158" width="125" height="30" as="geometry"/></mxCell>

        <mxCell id="m5-2" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="202" y="220" as="sourcePoint"/><mxPoint x="337" y="220" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5-2t" value="redeem(code,userId,orderId,orderAmount)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="205" y="198" width="130" height="20" as="geometry"/></mxCell>

        <mxCell id="m5-3" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="337" y="250" as="sourcePoint"/><mxPoint x="750" y="250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5-3t" value="getCoupon(code) FROM coupons" style="text;html=1;fontSize=8;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="400" y="228" width="150" height="20" as="geometry"/></mxCell>

        <mxCell id="m5-4" value="validateCoupon(coupon, orderAmount):&#10;✓ isActive? ✓ 有效期? ✓ 使用次数? ✓ 最低金额?" style="text;html=1;fontSize=9;align=left;fillColor=none;strokeColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="270" y="285" width="220" height="32" as="geometry"/></mxCell>

        <mxCell id="m5-5" value="calculateDiscount:&#10;PERCENTAGE → orderAmount × value / 100&#10;FIXED → value (不超过 orderAmount)" style="text;html=1;fontSize=9;align=left;fillColor=none;strokeColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="270" y="330" width="220" height="40" as="geometry"/></mxCell>

        <mxCell id="m5-6" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="337" y="385" as="sourcePoint"/><mxPoint x="750" y="385" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5-6t" value="UPDATE coupons SET usage_count=usage_count+1; INSERT INTO coupon_redemptions" style="text;html=1;fontSize=8;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="400" y="363" width="240" height="20" as="geometry"/></mxCell>

        <mxCell id="m5-7" value="" style="endArrow=open;html=1;dashed=1;endFill=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="202" y="420" as="sourcePoint"/><mxPoint x="70" y="420" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5-7t" value="ApiResponse (CouponRedemption)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="75" y="398" width="125" height="20" as="geometry"/></mxCell>

        <!-- === Flow B: Flash Sale === -->
        <mxCell id="f5b-label" value="&lt;b&gt;秒杀活动流程&lt;/b&gt;" style="text;html=1;fontSize=11;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="480" width="130" height="25" as="geometry" />
        </mxCell>

        <!-- Admin creates flash sale -->
        <mxCell id="m5-b1" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="70" y="520" as="sourcePoint"/><mxPoint x="202" y="520" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5-b1t" value="[管理员] 创建秒杀活动" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="75" y="498" width="125" height="20" as="geometry"/></mxCell>

