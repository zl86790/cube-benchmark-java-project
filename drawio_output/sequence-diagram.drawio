        <mxCell id="p4-is" value="Inventory&lt;br&gt;Service" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="60" width="90" height="50" as="geometry" />
