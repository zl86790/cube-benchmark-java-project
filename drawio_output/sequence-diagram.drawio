        <mxCell id="p4-rc" value="Return&lt;br&gt;Controller" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="60" width="85" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p4-rs" value="Return&lt;br&gt;Service" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="60" width="80" height="50" as="geometry" />
