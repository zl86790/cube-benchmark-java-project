        <mxCell id="m4-5" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="370" as="sourcePoint"/><mxPoint x="222" y="370" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4-5t" value="PUT /api/returns/{id}/approve" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="85" y="348" width="135" height="20" as="geometry"/></mxCell>

        <mxCell id="m4-6" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="222" y="400" as="sourcePoint"/><mxPoint x="360" y="400" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4-6t" value="approve(returnRequestId)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="228" y="378" width="130" height="20" as="geometry"/></mxCell>

        <mxCell id="m4-7" value="检查 status == REQUESTED? 是 → status = APPROVED, save()" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="280" y="430" width="240" height="20" as="geometry"/></mxCell>

        <!-- === Step 3: Process Refund === -->
        <mxCell id="f4c-label" value="&lt;b&gt;3. 处理退款&lt;/b&gt;" style="text;html=1;fontSize=11;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="120" height="25" as="geometry" />
        </mxCell>

        <mxCell id="m4-8" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="520" as="sourcePoint"/><mxPoint x="222" y="520" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4-8t" value="POST /api/returns/{id}/refund&#10;(amount)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="85" y="498" width="135" height="30" as="geometry"/></mxCell>

        <mxCell id="m4-9" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#d6242d;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="222" y="560" as="sourcePoint"/><mxPoint x="360" y="560" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4-9t" value="processRefund(returnRequestId, amount)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="225" y="538" width="135" height="20" as="geometry"/></mxCell>

        <mxCell id="m4-10" value="验证 status ∈ {APPROVED, RECEIVED}" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="280" y="590" width="170" height="20" as="geometry"/></mxCell>

        <mxCell id="m4-11" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="620" as="sourcePoint"/><mxPoint x="800" y="620" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4-11t" value="创建 RefundRecord (status=COMPLETED) → INSERT; 更新 return_requests status=REFUNDED" style="text;html=1;fontSize=8;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="390" y="598" width="260" height="20" as="geometry"/></mxCell>

        <!-- === Step 4: Restore Stock === -->
        <mxCell id="f4d-label" value="&lt;b&gt;4. 恢复库存&lt;/b&gt;" style="text;html=1;fontSize=11;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1">
