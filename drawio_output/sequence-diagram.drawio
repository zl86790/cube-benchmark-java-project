        <mxCell id="m2-7b" value="" style="endArrow=open;html=1;dashed=1;endFill=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="620" as="sourcePoint"/><mxPoint x="80" y="620" as="targetPoint"/></mxGeometry></mxCell>
