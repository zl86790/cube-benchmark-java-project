        <mxCell id="p1-os" value="Order&lt;br&gt;Service" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="60" width="90" height="50" as="geometry" />
