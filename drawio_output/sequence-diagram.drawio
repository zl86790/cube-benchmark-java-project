          <mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="625" y="110" as="sourcePoint"/><mxPoint x="625" y="1350" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="ll1-ps" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="765" y="110" as="sourcePoint"/><mxPoint x="765" y="1350" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="ll1-calc" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="905" y="110" as="sourcePoint"/><mxPoint x="905" y="1350" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="ll1-ns" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="1045" y="110" as="sourcePoint"/><mxPoint x="1045" y="1350" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="ll1-db" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="1180" y="115" as="sourcePoint"/><mxPoint x="1180" y="1350" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- Messages -->
        <!-- 1. POST /api/orders -->
        <mxCell id="m1-1" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="80" y="150" as="sourcePoint"/><mxPoint x="215" y="150" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m1-1t" value="POST /api/orders&#10;(userId,addressId,discountCode,notes)" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="85" y="128" width="130" height="20" as="geometry" />
        </mxCell>

        <!-- 2. createOrder() -->
        <mxCell id="m1-2" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="215" y="185" as="sourcePoint"/><mxPoint x="355" y="185" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m1-2t" value="createOrder(userId,addressId,discountCode,notes)" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="220" y="163" width="135" height="20" as="geometry" />
        </mxCell>

        <!-- 3. getCartByUserId -->
        <mxCell id="m1-3" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="355" y="230" as="sourcePoint"/><mxPoint x="490" y="230" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m1-3t" value="getCartByUserId(userId)" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="360" y="208" width="125" height="20" as="geometry" />
        </mxCell>

        <!-- 4. return cart -->
        <mxCell id="m1-4" value="" style="endArrow=open;html=1;dashed=1;endFill=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="490" y="255" as="sourcePoint"/><mxPoint x="355" y="255" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m1-4t" value="Cart (items)" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="368" y="233" width="110" height="20" as="geometry" />
        </mxCell>

        <!-- 5. calculateOrderTotals → internal calls -->
        <mxCell id="m1-5a" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="355" y="300" as="sourcePoint"/><mxPoint x="905" y="300" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m1-5at" value="calculateOrderTotals(order, discountCode)&#10;├ applyDiscount → 计算折扣金额&#10;├ calculateTax → 计算税费&#10;└ calculateShippingFee → 计算运费" style="text;html=1;fontSize=8;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="370" y="278" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- 6. return totals -->
        <mxCell id="m1-5b" value="" style="endArrow=open;html=1;dashed=1;endFill=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="905" y="325" as="sourcePoint"/><mxPoint x="355" y="325" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m1-5bt" value="subtotal, discount, tax, shipping, totalAmount" style="text;html=1;fontSize=8;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="450" y="303" width="310" height="20" as="geometry" />
        </mxCell>

        <!-- 7. deductStock -->
        <mxCell id="m1-6" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#d6242d;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="355" y="370" as="sourcePoint"/><mxPoint x="625" y="370" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m1-6t" value="deductStock(orderItems)" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="370" y="348" width="130" height="20" as="geometry" />
        </mxCell>

        <!-- 8. inventory check + update DB -->
        <mxCell id="m1-6b" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#d6242d;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="625" y="395" as="sourcePoint"/><mxPoint x="1180" y="395" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m1-6bt" value="UPDATE inventories SET available_quantity = available_quantity - ?" style="text;html=1;fontSize=8;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="640" y="373" width="210" height="20" as="geometry" />
        </mxCell>

        <!-- 9. return stock result -->
        <mxCell id="m1-6c" value="" style="endArrow=open;html=1;dashed=1;endFill=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="625" y="420" as="sourcePoint"/><mxPoint x="355" y="420" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m1-6ct" value="true (stock deducted)" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="395" y="398" width="120" height="20" as="geometry" />
        </mxCell>

        <!-- 10. save order to DB -->
        <mxCell id="m1-7" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="355" y="465" as="sourcePoint"/><mxPoint x="1180" y="465" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m1-7t" value="save(order) → INSERT INTO orders..." style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="500" y="443" width="180" height="20" as="geometry" />
        </mxCell>

        <!-- 11. processPayment -->
        <mxCell id="m1-8" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#d6242d;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="355" y="510" as="sourcePoint"/><mxPoint x="765" y="510" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m1-8t" value="processPayment(order, CREDIT_CARD)" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="380" y="488" width="170" height="20" as="geometry" />
        </mxCell>

        <!-- 12. simulate gateway -->
        <mxCell id="m1-8b" value="simulatePaymentGateway() → 95%成功率" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="660" y="535" width="160" height="20" as="geometry" />
        </mxCell>

        <!-- 13. save payment -->
        <mxCell id="m1-8c" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="765" y="570" as="sourcePoint"/><mxPoint x="1180" y="570" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m1-8ct" value="save(payment) → INSERT INTO payments..." style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="820" y="548" width="190" height="20" as="geometry" />
        </mxCell>

        <!-- 14. payment result -->
        <mxCell id="m1-8d" value="" style="endArrow=open;html=1;dashed=1;endFill=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="765" y="595" as="sourcePoint"/><mxPoint x="355" y="595" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m1-8dt" value="Payment (COMPLETED), order.status → CONFIRMED" style="text;html=1;fontSize=8;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="405" y="573" width="210" height="20" as="geometry" />
        </mxCell>

        <!-- 15. clearCart -->
        <mxCell id="m1-9" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="355" y="640" as="sourcePoint"/><mxPoint x="490" y="640" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m1-9t" value="clearCart(userId)" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="360" y="618" width="125" height="20" as="geometry" />
        </mxCell>

        <!-- 16. clearCart DB -->
        <mxCell id="m1-9b" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="490" y="665" as="sourcePoint"/><mxPoint x="1180" y="665" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m1-9bt" value="DELETE FROM cart_items WHERE cart_id=?; save(cart)" style="text;html=1;fontSize=8;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="550" y="643" width="200" height="20" as="geometry" />
        </mxCell>

        <!-- 17. sendOrderConfirmation -->
        <mxCell id="m1-10" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="355" y="710" as="sourcePoint"/><mxPoint x="1045" y="710" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m1-10t" value="sendOrderConfirmation(order)" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="500" y="688" width="180" height="20" as="geometry" />
        </mxCell>

        <!-- 18. return saved order -->
        <mxCell id="m1-11" value="" style="endArrow=open;html=1;dashed=1;endFill=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="355" y="755" as="sourcePoint"/><mxPoint x="215" y="755" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m1-11t" value="OrderDTO" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="240" y="733" width="85" height="20" as="geometry" />
        </mxCell>

        <!-- 19. HTTP Response -->
        <mxCell id="m1-12" value="" style="endArrow=open;html=1;dashed=1;endFill=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="215" y="800" as="sourcePoint"/><mxPoint x="80" y="800" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m1-12t" value="ApiResponse&lt;OrderDTO&gt; (200 OK)" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="85" y="778" width="128" height="20" as="geometry" />
        </mxCell>

        <!-- Notes -->
        <mxCell id="note1" value="&lt;b&gt;关键事务边界:&lt;/b&gt; @Transactional 包裹整个 createOrder()&#10;1. 购物车为空则抛异常&#10;2. 库存不足则抛异常&#10;3. 支付成功率 95%（模拟）&#10;4. 下单成功后清空购物车" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="400" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ===== Diagram 2: 购物车管理流程 ===== -->
  <diagram name="2-购物车管理流程" id="seq-cart">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connectable="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title2" value="&lt;b&gt;购物车管理流程 (Cart Management Flow)&lt;/b&gt;" style="text;html=1;fontSize=16;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="450" y="10" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- Participants -->
        <mxCell id="p2-user" value="用户&lt;br&gt;User" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2-cc" value="Cart&lt;br&gt;Controller" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="60" width="90" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2-cs" value="Cart&lt;br&gt;Service" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="60" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2-ps" value="Product&lt;br&gt;Service" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="60" width="90" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2-db" value="数据库&lt;br&gt;DB" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;size=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="55" width="80" height="60" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="ll2-u" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="110" as="sourcePoint"/><mxPoint x="80" y="1100" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll2-cc" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="225" y="110" as="sourcePoint"/><mxPoint x="225" y="1100" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll2-cs" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370" y="110" as="sourcePoint"/><mxPoint x="370" y="1100" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll2-ps" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="110" as="sourcePoint"/><mxPoint x="515" y="1100" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll2-db" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660" y="115" as="sourcePoint"/><mxPoint x="660" y="1100" as="targetPoint"/></mxGeometry></mxCell>

        <!-- === Flow A: Get Cart === -->
        <mxCell id="f2a-label" value="&lt;b&gt;获取购物车&lt;/b&gt;" style="text;html=1;fontSize=11;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="100" height="25" as="geometry" />
        </mxCell>

