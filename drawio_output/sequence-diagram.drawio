  <!-- ===== Diagram 3: 支付与退款流程 ===== -->
  <diagram name="3-支付与退款流程" id="seq-payment">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connectable="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title3" value="&lt;b&gt;支付与退款流程 (Payment &amp; Refund Flow)&lt;/b&gt;" style="text;html=1;fontSize=16;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="450" y="10" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- Participants -->
        <mxCell id="p3-os" value="Order&lt;br&gt;Service" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="90" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3-ps" value="Payment&lt;br&gt;Service" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="60" width="90" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3-gw" value="Payment&lt;br&gt;Gateway" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="60" width="90" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3-db" value="数据库&lt;br&gt;DB" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;size=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="55" width="80" height="60" as="geometry" />
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="ll3-os" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="85" y="110" as="sourcePoint"/><mxPoint x="85" y="1050" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll3-ps" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="110" as="sourcePoint"/><mxPoint x="245" y="1050" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll3-gw" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405" y="110" as="sourcePoint"/><mxPoint x="405" y="1050" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ll3-db" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="115" as="sourcePoint"/><mxPoint x="560" y="1050" as="targetPoint"/></mxGeometry></mxCell>

        <!-- === Flow A: Process Payment === -->
        <mxCell id="f3a-label" value="&lt;b&gt;处理支付&lt;/b&gt;" style="text;html=1;fontSize=11;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="100" height="25" as="geometry" />
        </mxCell>

        <mxCell id="m3-1" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="85" y="180" as="sourcePoint"/><mxPoint x="245" y="180" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3-1t" value="processPayment(order, CREDIT_CARD, cardNumber)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="90" y="158" width="150" height="20" as="geometry"/></mxCell>

        <mxCell id="m3-2" value="创建 Payment: status=PENDING,&#10;transactionId=TXN-{UUID}" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="200" y="210" width="170" height="30" as="geometry"/></mxCell>

        <mxCell id="m3-3" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#d6242d;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="255" as="sourcePoint"/><mxPoint x="405" y="255" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3-3t" value="simulatePaymentGateway()" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="255" y="233" width="145" height="20" as="geometry"/></mxCell>

        <mxCell id="m3-4" value="" style="endArrow=open;html=1;dashed=1;endFill=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="405" y="285" as="sourcePoint"/><mxPoint x="245" y="285" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3-4t" value="boolean (95% true)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="260" y="263" width="140" height="20" as="geometry"/></mxCell>

        <!-- alt: success / fail -->
        <mxCell id="alt3-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="220" y="310" width="250" height="190" as="geometry" />
        </mxCell>
        <mxCell id="alt3-label" value="alt [成功 95%]" style="text;html=1;fontSize=10;align=center;fillColor=none;strokeColor=none;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="310" width="90" height="20" as="geometry" />
        </mxCell>

        <mxCell id="m3-5a" value="payment.status = COMPLETED&#10;order.status = CONFIRMED&#10;payment.paidAt = now()" style="text;html=1;fontSize=9;align=left;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="225" y="340" width="155" height="35" as="geometry" />
        </mxCell>

        <mxCell id="m3-6a" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="390" as="sourcePoint"/><mxPoint x="560" y="390" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3-6at" value="save(payment) → INSERT INTO payments..." style="text;html=1;fontSize=8;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="290" y="368" width="180" height="20" as="geometry"/></mxCell>

        <mxCell id="m3-7a" value="[失败 5%] payment.status = FAILED" style="text;html=1;fontSize=9;align=left;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="225" y="460" width="170" height="20" as="geometry" />
        </mxCell>

        <mxCell id="m3-8" value="" style="endArrow=open;html=1;dashed=1;endFill=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="530" as="sourcePoint"/><mxPoint x="85" y="530" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3-8t" value="Payment (COMPLETED / FAILED)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="508" width="145" height="20" as="geometry"/></mxCell>

        <!-- === Flow B: Refund === -->
        <mxCell id="f3b-label" value="&lt;b&gt;退款&lt;/b&gt;" style="text;html=1;fontSize=11;align=center;fillColor=#e1d5e7;strokeColor=#9673a6;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="80" height="25" as="geometry" />
        </mxCell>

        <mxCell id="m3-b1" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="85" y="630" as="sourcePoint"/><mxPoint x="245" y="630" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3-b1t" value="refundPayment(paymentId)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="608" width="142" height="20" as="geometry"/></mxCell>

        <mxCell id="m3-b2" value="" style="endArrow=block;html=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="660" as="sourcePoint"/><mxPoint x="560" y="660" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3-b2t" value="getPayment(paymentId) from DB" style="text;html=1;fontSize=8;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="290" y="638" width="180" height="20" as="geometry"/></mxCell>

        <mxCell id="m3-b3" value="检查 status == COMPLETED?&#10;是 → status = REFUNDED, save()" style="text;html=1;fontSize=9;align=left;fillColor=none;strokeColor=none;dashed=1;" vertex="1" parent="1"><mxGeometry x="225" y="695" width="155" height="35" as="geometry"/></mxCell>

        <mxCell id="m3-b4" value="" style="endArrow=open;html=1;dashed=1;endFill=0;edgeStyle=orthogonalEdgeStyle;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="245" y="750" as="sourcePoint"/><mxPoint x="85" y="750" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3-b4t" value="Payment (REFUNDED)" style="text;html=1;fontSize=9;align=center;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="100" y="728" width="142" height="20" as="geometry"/></mxCell>

        <mxCell id="note3" value="&lt;b&gt;支付状态机:&lt;/b&gt; PENDING → COMPLETED / FAILED → REFUNDED&#10;&lt;b&gt;关键:&lt;/b&gt; 只能对 COMPLETED 状态的支付发起退款" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#cccccc;dashed=1;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="830" width="380" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ===== Diagram 4: 退货退款流程 ===== -->
  <diagram name="4-退货退款流程" id="seq-return">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connectable="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title4" value="&lt;b&gt;退货退款流程 (Return &amp; Refund Flow)&lt;/b&gt;" style="text;html=1;fontSize=16;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="420" y="10" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- Participants -->
